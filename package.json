{
  "name": "portfolio-soedje",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Portfolio de SOEDJE Kokou Ariel Caesar — Astro + React, Cloudflare Workers, D1, R2.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "images": "node scripts/optimize-images.mjs",
    "deploy": "astro build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.12",
    "@astrojs/react": "^7.1.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@netlify/blobs": "^10.7.13",
    "@netlify/cache": "^4.2.1",
    "astro": "^7.4.8",
    "paseto-ts": "^2.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
