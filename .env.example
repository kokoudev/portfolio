# Copier vers .env (jamais commité) puis remplir.
# Générer les valeurs secrètes avec :  node scripts/setup-admin.mjs

# Nom d'utilisateur de l'admin
ADMIN_USERNAME=
# Hash scrypt du mot de passe admin (format scrypt:N:r:p:sel:hash) — jamais le mot de passe en clair
ADMIN_PASSWORD_HASH=
# Clé PASETO v4.local (format k4.local.xxxx) pour chiffrer les sessions
PASETO_LOCAL_KEY=

# Cloudflare Turnstile (gratuit) — https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Compte GitHub dont on affiche les dépôts publics
GITHUB_USERNAME=kokoudev
# Optionnel : jeton GitHub en lecture seule (sans aucune permission) pour éviter la limite de 60 req/h
GITHUB_TOKEN=

# URL publique du site (pour Open Graph et la vérification d'origine)
SITE_URL=https://soedje-portfolio.netlify.app
