---
import Img from '../ui/Img.astro';
import type { Certification } from '../../lib/schema';
interface Props { items: Certification[] }
const { items } = Astro.props;
---
<section id="certifications" class="wrap section" aria-labelledby="certifs-title">
  <h2 id="certifs-title" class="h2"><span class="eyebrow" aria-hidden="true">04 / CERTIFICATIONS</span>Certifié, <span class="outline">vérifiable</span></h2>
  <ul class="grid">
    {items.map((c) => (
      <li class="tile cert reveal">
        <div class="zoom img">{c.image ? <Img src={c.image} alt={`Certificat ${c.issuer} : ${c.title}`} widths={[320, 640]} sizes="(max-width: 640px) 100vw, 320px" position="top" /> : <span class="todo">[ IMAGE À AJOUTER ]</span>}</div>
        <div class="b">
          <p class="mono meta">{c.issuer.toUpperCase()} · {c.date.toUpperCase()}</p>
          <h3 class="t">{c.title}</h3>
          {c.description && <p class="d">{c.description}</p>}
          {c.gallery.length > 0 && (
            <ul class="gal" aria-label={`Autres images : ${c.title}`}>
              {c.gallery.map((g) => <li class="zoom"><Img src={g.image} alt={g.alt || `Certificat ${c.title}`} widths={[200, 400]} sizes="120px" position="top" /></li>)}
            </ul>
          )}
          {c.verifyUrl ? (
            <a href={c.verifyUrl} class="mono v" target="_blank" rel="noopener noreferrer">Vérifier ↗<span class="sr-only"> le certificat {c.title} (nouvel onglet)</span></a>
          ) : (
            <span class="todo v">[ LIEN À AJOUTER ]</span>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid{list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:18px}
  .cert{display:flex;flex-direction:column;overflow:hidden}
  .img{aspect-ratio:4/3;background:#F2F2F2;display:grid;place-items:center}
  .img :global(img){width:100%;height:100%;object-fit:cover}
  .b{padding:18px;display:flex;flex-direction:column;gap:8px;flex:1}
  .gal{list-style:none;margin:4px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
  .gal li{aspect-ratio:4/3;background:#F2F2F2;border:1px solid var(--line-2)}
  .gal :global(img){width:100%;height:100%;object-fit:cover}
  .meta{font-size:11px;color:var(--acc);letter-spacing:.3px}
  .t{font-size:1.05rem;font-weight:600;color:var(--text-strong);line-height:1.35}
  .d{font-size:14px;color:var(--text-3);line-height:1.5}
  .v{margin-top:auto;font-size:13px;font-weight:600;text-decoration:none;padding:10px 0;min-height:44px;display:inline-flex;align-items:center}
</style>
