<section class="wrap facts" aria-label="En bref">
  <div class="tile f"><p class="k mono">BASÉ À</p><p class="v disp">Lomé, Togo</p><p class="s">GMT+0, aligné sur l’Europe</p></div>
  <div class="tile f"><p class="k mono">FORMATION</p><p class="v disp">Licence Génie Logiciel</p><p class="s">IPNET, Lomé · 2023 – 2026</p></div>
  <div class="tile f"><p class="k mono">PROJETS</p><p class="v disp">2 en ligne · 1 en cours</p><p class="s">dont un client en freelance</p></div>
  <div class="tile f pk"><p class="k mono">OUTIL FÉTICHE</p><p class="v disp">L’IA, au quotidien</p><p class="s">agents de code, images, documents</p></div>
</section>
<section class="wrap term-wrap" aria-label="Terminal">
  <div class="term">
    <p class="mono bar" aria-hidden="true">● ● ●&nbsp;&nbsp;~/evrely</p>
    <p class="mono cmd"><span class="acc">$</span> whoami</p>
    <p class="mono out"><span class="type">développeur qui livre, apprend vite.</span></p>
  </div>
</section>

<style>
  .facts{padding-top:clamp(64px,8vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:16px}
  .f{padding:24px}
  .f.pk{border-color:var(--punk)}
  .k{font-size:12px;color:var(--muted);margin-bottom:10px}
  .pk .k{color:var(--punk-soft)}
  .v{font-size:clamp(1.1rem,1.6vw,1.375rem);font-weight:800;color:var(--text-strong);line-height:1.2}
  .s{margin-top:8px;font-size:14px;color:var(--text-3)}
  .term-wrap{padding-top:40px}
  .term{background:var(--bg-2);border:1px solid var(--line-2);padding:22px 26px;max-width:760px}
  .bar{font-size:12px;color:var(--muted);margin-bottom:12px}
  .cmd{font-size:15px;color:var(--text-2);margin-bottom:8px}
  .out{font-size:15px;color:var(--text-strong)}
  .acc{color:var(--acc)}
</style>
