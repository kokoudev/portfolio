---
/**
 * Lecteur YouTube léger : seule une vignette est affichée ; l'iframe (youtube-nocookie)
 * n'est chargée qu'au clic. Aucune donnée n'est envoyée à YouTube avant.
 */
interface Props { id: string; title: string }
const { id, title } = Astro.props;
const valid = /^[A-Za-z0-9_-]{11}$/.test(id);
---
{valid && (
  <div class="yt" data-yt-lite={id} data-title={title}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <button type="button" class="play" aria-label={`Lire la vidéo : ${title}`}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="#B6FF5C" /></svg>
    </button>
    <p class="mono cap">{title}</p>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-yt-lite]').forEach((box) => {
    const id = box.dataset.ytLite ?? '';
    if (!/^[A-Za-z0-9_-]{11}$/.test(id)) return;
    box.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.title = box.dataset.title ?? 'Vidéo';
      f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.setAttribute('allowfullscreen', '');
      f.className = 'yt-frame';
      box.replaceChildren(f);
      f.focus();
    }, { once: true });
  });
</script>

<style>
  .yt{position:relative;aspect-ratio:16/9;background:#000;overflow:hidden;border:1px solid var(--line-2)}
  .yt img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.7}
  .play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:68px;height:68px;border-radius:50%;border:2px solid var(--acc);background:rgba(7,16,13,.85);cursor:pointer;display:grid;place-items:center;transition:transform .2s,box-shadow .2s}
  .play:hover{transform:translate(-50%,-50%) scale(1.08);box-shadow:0 0 0 8px rgba(182,255,92,.15)}
  .cap{position:absolute;left:0;right:0;bottom:0;margin:0;padding:8px 12px;font-size:12px;color:var(--text);background:linear-gradient(transparent,rgba(0,0,0,.8))}
  .yt :global(.yt-frame){position:absolute;inset:0;width:100%;height:100%;border:0}
</style>
