---
import { Picture } from 'astro:assets';
import { resolveImage, cdnUrl } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Cadrage : 'top' (haut centré) ou 'top-left' (haut gauche) */
  position?: 'top' | 'top-left' | 'center';
}
const { src, alt, widths = [400, 800, 1200], sizes = '(max-width: 768px) 100vw, 50vw', class: cls, loading = 'lazy', fetchpriority = 'auto', position = 'center' } = Astro.props;
const r = resolveImage(src);
const classes = [cls, `pos-${position}`].filter(Boolean).join(' ');
---
{r?.kind === 'asset' && (
  <Picture
    src={r.meta}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths.filter((w) => w <= r.meta.width).concat(widths.some((w) => w > r.meta.width) ? [r.meta.width] : [])}
    sizes={sizes}
    loading={loading}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    fetchpriority={fetchpriority}
    class={classes}
  />
)}
{r?.kind === 'media' && !r.isPdf && (
  <img
    src={cdnUrl(r.src, widths[widths.length - 1])}
    srcset={widths.map((w) => `${cdnUrl(r.src, w)} ${w}w`).join(', ')}
    sizes={sizes}
    alt={alt}
    loading={loading}
    decoding="async"
    class={classes}
  />
)}
