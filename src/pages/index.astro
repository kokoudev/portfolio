---
import Base from '../layouts/Base.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Marquee from '../components/sections/Marquee.astro';
import Facts from '../components/sections/Facts.astro';
import Projects from '../components/sections/Projects.astro';
import Formation from '../components/sections/Formation.astro';
import Certifications from '../components/sections/Certifications.astro';
import Defense from '../components/sections/Defense.astro';
import Diplomas from '../components/sections/Diplomas.astro';
import Contact from '../components/sections/Contact.astro';
import Faq from '../components/sections/Faq.astro';
import Skills from '../components/sections/Skills.astro';
import { readContent } from '../lib/store';
import { getRepos } from '../lib/github';

export const prerender = false;

const [content, repos] = await Promise.all([readContent(), getRepos()]);

// Mise en cache sur le CDN Netlify ; purgée automatiquement à chaque enregistrement depuis l'admin
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, durable, s-maxage=3600, stale-while-revalidate=604800');
Astro.response.headers.set('Netlify-Cache-Tag', 'content');
Astro.response.headers.set('Netlify-Vary', 'query=none'); // ?x=1, ?x=2… ne contournent pas le cache
---
<Base content={content} withFaq>
  <a class="skip" href="#main">Aller au contenu</a>
  <div class="spot" aria-hidden="true"></div>
  <Header />
  <main id="main">
    <Hero />
    <Marquee text="BUILD ✦ GROW ✦ SHIP ✦ LOMÉ ✦ WEB ✦ MOBILE ✦ IOT ✦ IA ✦ " />
    <Facts projects={content.projects} />
    <Projects projects={content.projects} repos={repos} />
    <Skills projects={content.projects} />
    <Marquee text="SOLARPUNK DEV ✦ MADE IN LOMÉ ✦ " variant="outline" />
    <Formation items={content.formations} />
    <Certifications items={content.certifications} />
    <Defense video={content.video} />
    <Diplomas items={content.diplomas} />
    <Faq />
    <Contact />
  </main>
</Base>

<script>
  // Halo lumineux qui suit le curseur (désactivé sur tactile et en mouvement réduit)
  const spot = document.querySelector<HTMLElement>('.spot');
  if (spot && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        spot.style.setProperty('--x', `${e.clientX}px`);
        spot.style.setProperty('--y', `${e.clientY}px`);
        spot.classList.add('on');
      });
    }, { passive: true });
  }
</script>

<style>
  .spot{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:0;transition:opacity .4s;background:radial-gradient(520px circle at var(--x,70%) var(--y,20%),rgba(182,255,92,.08),transparent 60%)}
  .spot.on{opacity:1}
  main{position:relative;z-index:2}
</style>
